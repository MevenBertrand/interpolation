%% Induction rules

\RequirePackage{mathpartir}
\renewcommand{\TirNameStyle}{\textsc} %style of the induction rule name for mathpartir

%%Reference to inference rules, inspired by https://tex.stackexchange.com/questions/340788/cross-referencing-inference-rules

\NewDocumentCommand \mprlabel { m }{%
	\def\@currentlabelname{#1}%
  \phantomsection % Creating an anchor to get a correct hyper reference link
}

\NewDocumentCommand \inferdef {o m m}{%
  \inferrule*[vcenter,left=\IfValueT{#1}{#1}]{#2}{#3}
  \IfValueT{#1}{\mprlabel{\textsc{#1}}}
}

\newcommand{\ruleref}[1]{Rule \nameref{#1}}

%mathpar hack for a standout judgment form,
%inspired by http://lists.seas.upenn.edu/pipermail/types-list/2019/002157.html

\newcommand{\maflushleft}{\strut \and \hfill}

\NewDocumentCommand{\jform}{m o}{\boxed{#1}\IfValueT{#2}{\quad \text{\textcolor{gray}{#2}}}\maflushleft\\}

\definecolor{impl}{HTML}{808080}
\NewDocumentCommand{\impl}{m}{\mathcolor{impl}{#1}}

