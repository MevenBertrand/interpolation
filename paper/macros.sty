%% Font stuff

% To allow like breaks at points, see https://tex.stackexchange.com/questions/19094/allowing-line-break-at-in-inline-math-mode-breaks-citations
\AtBeginDocument{%
  \mathchardef\mathpoint\mathcode`\.
  \mathcode`\.="8000
}
{\catcode`.=\active
  \gdef.{\mathpoint\discretionary{}{}{}}
}

% For better spacing of :, see https://tex.stackexchange.com/questions/64423/exchange-meaning-of-and-colon

\AtBeginDocument{\DeclareMathSymbol{:}{\mathpunct}{operators}{"3A}}
\def\colon{\mathrel{:}}

%See https://tex.stackexchange.com/questions/477662/fontspec-breaks-capital-greek-letters-in-declaremathoperator?rq=1
\let\l\relax
\DeclareMathOperator{\l}{\lambda}

\let\P\relax
\DeclareMathOperator{\P}{\Pi}

\DeclareDocumentCommand{\ctxty}{o m}{\vdash\IfValueT{#1}{_{#1}} #2}
\DeclareDocumentCommand{\ty}{}{\colon}
\DeclareDocumentCommand{\typing}{o m m o}{#2 \vdash\IfValueT{#1}{_{#1}} #3 \IfValueT{#4}{\ty #4}}
\DeclareDocumentCommand{\semty}{o m m o}{#2 \Vdash\IfValueT{#1}{_{#1}} #3 \IfValueT{#4}{\ty #4}}


\colorlet{icol}{YellowOrange}
\colorlet{ccol}{CarnationPink}
\DeclareDocumentCommand{\icol}{m}{\mathcolor{icol}{#1}}
\DeclareDocumentCommand{\ccol}{m}{\mathcolor{ccol}{#1}}

\colorlet{scol}{BrickRed}
\colorlet{tcol}{RoyalBlue}
\colorlet{mcol}{Purple}
\DeclareDocumentCommand{\scol}{m}{\mathcolor{scol}{#1}}
\DeclareDocumentCommand{\tcol}{m}{\mathcolor{tcol}{#1}}
\DeclareDocumentCommand{\mcol}{m}{\mathcolor{mcol}{#1}}

\DeclareDocumentCommand{\icolop}{}{\triangleright}
\DeclareDocumentCommand{\ccolop}{}{\triangleleft}
\DeclareDocumentCommand{\infer}{o m m m}{#2 \vdash\IfValueT{#1}{_{#1}} \icol{#3} \icolop #4}
\DeclareDocumentCommand{\check}{o m m m}{#2 \vdash\IfValueT{#1}{_{#1}} \ccol{#3} \ccolop #4}
\DeclareDocumentCommand{\stackty}{m m m m}{#1 \mid #3 \vdash \icol{#2} \icolop #4}

\DeclareDocumentCommand{\convop}{}{\equiv}
\DeclareDocumentCommand{\defconvop}{}{\mathrel{\vcentcolon\vcentcolon\convop}}
\DeclareDocumentCommand{\conv}{m m m o}{
  #1 \vdash #2 \convop #3 \IfValueT{#4}{\colon #4}}
\DeclareDocumentCommand{\defconv}{m m m o}{
  #1 \vdash #2 \defconvop #3 \IfValueT{#4}{\colon #4}}

\DeclareDocumentCommand{\oredop}{}{\rightsquigarrow}
\DeclareDocumentCommand{\redop}{}{\oredop^*}
\DeclareDocumentCommand{\ored}{m m}{#1 \oredop #2}
\DeclareDocumentCommand{\red}{m m}{#1 \redop #2}
\DeclareDocumentCommand{\lred}{m m}{#1 \redop #2}


